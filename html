<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>J Supermarket Poster</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
}

.poster {
    min-height: 520px;
    padding: 45px 7%;
    background: linear-gradient(135deg, #eaffdf, #ffffff);
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
}

/* LEFT SIDE */
.poster-content {
    width: 55%;
}

.logo {
    font-size: 28px;
    font-weight: bold;
    color: #15803d;
    margin-bottom: 25px;
}

.logo span {
    color: #f59e0b;
}

.small-text {
    color: #15803d;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 10px;
}

.poster h1 {
    font-size: 48px;
    line-height: 1.1;
    color: #14532d;
    margin-bottom: 18px;
}

.poster p {
    font-size: 17px;
    color: #555;
    line-height: 1.6;
    max-width: 550px;
}

.shop-btn {
    display: inline-block;
    margin-top: 25px;
    padding: 14px 30px;
    background: #fbbf24;
    color: #14532d;
    text-decoration: none;
    font-weight: bold;
    border-radius: 30px;
    transition: 0.3s;
}

.shop-btn:hover {
    background: #f59e0b;
    transform: scale(1.05);
}

/* RIGHT SIDE */
.poster-image {
    width: 40%;
    text-align: center;
}

.cart {
    font-size: 170px;
    margin-bottom: 10px;
}

.features {
    display: flex;
    gap: 15px;
    margin-top: 30px;
    flex-wrap: wrap;
}

.feature {
    background: white;
    padding: 12px 18px;
    border-radius: 12px;
    box-shadow: 0 4px 12px #0001;
    color: #166534;
    font-weight: bold;
}

/* MOBILE */
@media(max-width: 768px) {
    .poster {
        flex-direction: column;
        text-align: center;
        padding: 35px 20px;
    }

    .poster-content,
    .poster-image {
        width: 100%;
    }

    .poster h1 {
        font-size: 36px;
    }

    .poster p {
        font-size: 15px;
    }

    .cart {
        font-size: 110px;
        margin-top: 30px;
    }

    .features {
        justify-content: center;
    }
}
</style>
</head>

<body>

<section class="poster">

    <div class="poster-content">

        <div class="logo">
            🛒 J <span>Supermarket</span>
        </div>

        <div class="small-text">
            Fresh • Quality • Every Day
        </div>

        <h1>
            Your Daily Needs<br>
            Under One Roof
        </h1>

        <p>
            Fresh groceries, fruits, vegetables, dairy,
            beverages and daily essentials at great prices.
        </p>

        <a href="#shop" class="shop-btn">
            Shop Now
        </a>

        <div class="features">
            <div class="feature">🥬 Fresh Products</div>
            <div class="feature">⭐ Trusted Quality</div>
            <div class="feature">🚚 Fast Delivery</div>
            <div class="feature">💰 Best Prices</div>
        </div>

    </div>

    <div class="poster-image">
        <div class="cart">🛒</div>

        <h2 style="color:#15803d;">
            Good Food<br>Better Life
        </h2>

        <p style="margin-top:10px;">
            Shop Smart • Live Better
        </p>
    </div>

</section>

</body>
</html>
